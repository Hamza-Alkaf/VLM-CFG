dataset_path: parquet
dataset_kwargs:
  data_files:
    test: !datapath phd_sub10/phd_sub10.parquet
  token: True
test_split: test
output_type: generate_until

doc_to_visual: !function phd_utils.phd_doc_to_visual
doc_to_text: !function phd_utils.phd_doc_to_text
doc_to_target: "answer"

lmms_eval_specific_kwargs:
  default:
    pre_prompt: ""
    # Leading space, no newline: reproduces phd_model_inference.py's
    # f"{question} Answer with [yes/no] single word only" byte for byte.
    post_prompt: " Answer with [yes/no] single word only"

generation_kwargs:
  max_new_tokens: 32
  temperature: 0
  do_sample: False

process_results: !function phd_utils.phd_process_results

metric_list:
  - metric: phd_index
    aggregation: !function phd_utils.phd_aggregate_index
    higher_is_better: true
  - metric: phd_yes_recall
    aggregation: !function phd_utils.phd_aggregate_yes_recall
    higher_is_better: true
  - metric: phd_no_recall
    aggregation: !function phd_utils.phd_aggregate_no_recall
    higher_is_better: true
  - metric: phd_accuracy
    aggregation: !function phd_utils.phd_aggregate_accuracy
    higher_is_better: true
  - metric: phd_invalid_rate
    aggregation: !function phd_utils.phd_aggregate_invalid_rate
    higher_is_better: false

metadata:
  - version: 0.0
