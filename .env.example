# Copy to .env (scripts/setup_env.sh does this) and fill in. .env is gitignored.
# vlmcfg-eval and scripts/prepare_data.sh read it.

# Keys (README, "Keys")
# Hugging Face access token, read access (https://huggingface.co/settings/tokens).
# Recommended: anonymous Hub downloads are rate-limited; required for gated models or
# datasets.
HF_TOKEN=
# Weights & Biases API key (https://wandb.ai/authorize). Only for lmms-eval's
# --wandb_args.
WANDB_API_KEY=

# Paths
# Where models and datasets are cached.
HF_HOME=./.cache/huggingface
# Where data/prepare_*.py write the locally built benchmark files.
VLMCFG_DATA_DIR=./data/build
# NLTK data fetched by setup_env.sh (OCRBench v2 and AMBER scorers).
NLTK_DATA=./.cache/nltk_data
